# Copia questo file in .env e modifica i valori.

# Cartella radice della libreria musicale.
# Il server NON scrive mai qui: la apre in sola lettura.
# Su Windows usa le barre normali: D:/Musica  oppure  D:\Musica
MUSIC_DIR=D:/percorso/da/definire

# Cartella di lavoro del server (database + cache copertine).
DATA_DIR=./data

# Token di accesso. Cambialo: e' l'unica cosa che protegge la libreria.
# Generane uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# Rete
HOST=0.0.0.0
PORT=8080

# Scansione
SCAN_ON_STARTUP=true
WATCH_LIBRARY=true
WATCH_DEBOUNCE_SECONDS=5

# Pagina web di test su /  (comoda ora, la spegnerai quando esporrai il server)
DEV_WEB_PLAYER=true
